# --- Core ---
PORT=8080
HOST=0.0.0.0
APP_NAME=code-agent
CONFIG_DIR=config/default
LOG_LEVEL=info
LOG_JSON=false

# --- Redis / Valkey ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASS=
REDIS_DB=0

# --- Local dev runtime: orchestrator talks to a locally running opencode ---
# Use `opencode serve --port 4096` or `opencode web --port 4096` on your host.
OPENCODE_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=

# --- Board provider tokens (referenced by boards.yaml auth.env) ---
JIRA_TOKEN_ALPHA=
JIRA_WEBHOOK_SECRET_ALPHA=
CLICKUP_TOKEN=
CLICKUP_WEBHOOK_SECRET=

# --- VCS bot tokens ---
GITLAB_BOT_TOKEN=
GITHUB_BOT_TOKEN=
