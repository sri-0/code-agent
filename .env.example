# Copy to .env and fill in. bootstrap.Init auto-loads .env via godotenv.

# --- Core ---
PORT=8080
HOST=0.0.0.0
APP_NAME=code-agent
CONFIG_DIR=config/local
LOG_LEVEL=debug
LOG_JSON=false

# Forces every board to use the "local" runtime entry regardless of
# runtime_ref. Useful for first-time end-to-end testing on your laptop.
RUNTIME_MODE=local

# --- Valkey / Redis (docker compose up -d) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASS=
REDIS_DB=0

# --- Local opencode ---
# Start with: opencode serve --port 4096 --hostname 127.0.0.1
# Leave the password empty unless you started opencode with --password.
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=

# --- Anthropic (used by your local opencode, not by this service) ---
ANTHROPIC_API_KEY=

# --- ClickUp (referenced by boards.yaml auth.env: CLICKUP_TOKEN) ---
# Personal token from ClickUp > Profile > Apps. Starts with pk_
CLICKUP_TOKEN=
# Only needed if you enable the webhook trigger (you won't for the first
# test — poll is simpler and requires no public URL).
CLICKUP_WEBHOOK_SECRET=

# --- GitHub bot token (referenced by boards.yaml auth.env: GITHUB_BOT_TOKEN) ---
# Classic PAT with repo + pull_requests scopes, or fine-grained token with
# "Pull requests: read/write" on prism-au/*.
GITHUB_BOT_TOKEN=
